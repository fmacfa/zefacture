# Generate private random values with: python tools/configure.py
APP_ENV=local
DEBUG=0
DJANGO_SECRET_KEY=replace_with_at_least_50_random_characters
POSTGRES_PASSWORD=replace_with_random_hex_password
APP_URL=http://127.0.0.1:8090
ALLOWED_HOSTS=127.0.0.1,localhost
HTTP_PORT=8090
# Optional container memory ceilings; tune for the host and document sizes.
WEB_MEMORY_LIMIT=1536m
WORKER_MEMORY_LIMIT=1536m
DB_MEMORY_LIMIT=1024m
PROXY_MEMORY_LIMIT=256m
APP_TIMEZONE=Europe/Paris
REGISTRATION_OPEN=0

# HTTPS: APP_ENV=production, APP_URL=https://factures.example.com,
# DOMAIN=factures.example.com, ALLOWED_HOSTS=factures.example.com,localhost,127.0.0.1
# TRUST_PROXY=1; docker compose --profile https up -d
TRUST_PROXY=0
PROXY_SHARED_SECRET=replace_with_random_proxy_secret
SECURE_SSL_REDIRECT=1
# Do not preload or include subdomains before checking all related services.
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
# Enabled by default in production; set 1 for local rehearsal as well.
# MFA_REQUIRED_FOR_ADMINS=1
# SENSITIVE_REAUTH_REQUIRED=1

# Use outbox for local setup. SMTP sends queued messages through the worker.
MAIL_TRANSPORT=outbox
# Full delivery locks, particularly for restored copies.
EMAIL_DELIVERY_DISABLED=0
WEBHOOK_DELIVERY_DISABLED=0
# Recovery lock for OAuth/SMTP/webhooks/PDP/AI/directory calls.
EXTERNAL_SERVICES_DISABLED=0
MAIL_FROM_EMAIL=factures@example.com
MAIL_FROM_NAME=ZeFacture
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=1
SMTP_SSL=0
# Optional defaults; credentials can also be entered in Emails > Connexion.
# GOOGLE_MAIL_CLIENT_ID=
# GOOGLE_MAIL_CLIENT_SECRET=
# MICROSOFT_MAIL_CLIENT_ID=
# MICROSOFT_MAIL_CLIENT_SECRET=
# Explicit private SMTP/webhook hosts; TLS remains required.
# OUTBOUND_ALLOWED_HOSTS=smtp.internal,automation.internal
# RESEND_API_KEY=

# Optional AI extraction. OCR remains local without these values.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
OCR_LANGUAGES=fra+eng

# Optional SUPERPDP integration; no external credentials required for local billing.
# SUPERPDP_OAUTH_CLIENT_ID=
# SUPERPDP_OAUTH_CLIENT_SECRET=
# SUPERPDP_OAUTH_REDIRECT_URI=https://factures.example.com/app/entreprise/pdp/callback
# SUPERPDP_WEBHOOK_SECRET=
# Polling is opt-in per company; the worker resumes durable cursors.
SUPERPDP_SYNC_INTERVAL=300

INSTANCE_CONTACT=Administrateur de cette instance
INSTANCE_LEGAL=Instance privée auto-hébergée. Renseigner l'identité de l'exploitant avant ouverture publique.
# Complement the public privacy page with actual retention and deletion procedures.
INSTANCE_PRIVACY_NOTES=
